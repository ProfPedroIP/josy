rules_version = '2';

// Regras do Firebase Storage do Josy Arcade.
//
// Só existe uma pasta: os recados de voz do chat.
//   - qualquer pessoa logada pode OUVIR (vocês dois)
//   - só o dono da pasta pode ENVIAR (ninguém grava em nome do outro)
//   - teto de 3 MB e só arquivos de áudio, para ninguém usar como HD de graça

service firebase.storage {
  match /b/{bucket}/o {

    match /chat_audio/{uid}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    // Nada mais é acessível
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
